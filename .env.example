# Copy to .env in the repository root:
#   copy .env.example .env
#
# Local processes should use 127.0.0.1. Docker Compose overrides HOST
# to the Qdrant service name, so leave this value as-is for either path.

HOST=127.0.0.1
PORT=6333
COLLECTION_NAME=linkedIn_jobs

# From https://console.groq.com — never commit the real key.
GROQ_API_KEY=

# Groq model used for extraction, tool calling, and CV tailoring.
# It must support function calling and JSON schema responses.
GENERATION_MODEL=openai/gpt-oss-20b
